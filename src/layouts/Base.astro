---
import { SITE } from "../site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Path of the Open Graph image, e.g. /og/my-post.png.
  image?: string;
  article?: { published: Date; modified?: Date; tags: string[] };
}

const { title, description = SITE.description, image = "/og/index.png", article } = Astro.props;
// Which header link to mark as the current page.
const path = Astro.url.pathname;
const section = path.startsWith("/tags/") ? "tags" : path.startsWith("/about/") ? "about" : "blog";
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url);
const imageUrl = new URL(image, SITE.url);
// Cloudflare Web Analytics is optional and cookieless. The token lives in the
// Cloudflare build settings, not in this repo; see the README.
const beacon = import.meta.env.CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          <meta property="article:author" content={SITE.author} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Set the theme before first paint so dark mode doesn't flash. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <!-- The same header as prignano.ai, with the blog's own links added. -->
    <header class="site-header">
      <a class="identity" href="/">
        <img class="avatar" src={SITE.avatar} alt="" width="56" height="56" />
        <span class="identity-text">
          <span class="name">{SITE.author}</span>
          <span class="bio">{SITE.bio}</span>
        </span>
      </a>
      <nav class="links">
        <a href="/" aria-current={section === "blog" ? "page" : undefined}>Blog</a>
        <a href="/tags/" aria-current={section === "tags" ? "page" : undefined}>Tags</a>
        <a href="/about/" aria-current={section === "about" ? "page" : undefined}>About</a>
        {SITE.links.map((link) => <a href={link.href}>{link.label}</a>)}
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {SITE.author}. Posts are licensed{" "}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>, code samples{" "}
        <a href={`${SITE.repo}/blob/main/LICENSE`}>MIT</a>.
      </p>
      <p class="footer-links">{SITE.links.map((link) => <a href={link.href}>{link.label}</a>)}<a href="/rss.xml">RSS</a></p>
    </footer>

    <script>
      import "../scripts/line-art";
      import "../scripts/theme";
    </script>
    {beacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })} />}
  </body>
</html>
