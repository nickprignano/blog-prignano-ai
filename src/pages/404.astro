---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="hero hero-slim">
    <line-art seed="404" hue="0" track=".hero" />
    <div class="hero-text">
      <h1>Page not found</h1>
      <p>That page doesn't exist. <a href="/">Back to the latest posts</a>.</p>
    </div>
  </section>
</Base>
