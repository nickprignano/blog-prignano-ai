---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, hueFor, readingMinutes, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { title, description, date, updated, tags, draft } = post.data;
const { Content } = await render(post);
---

<Base
  title={title}
  description={description}
  image={`/og/posts/${post.id}.png`}
  article={{ published: date, modified: updated, tags }}
>
  <article class="post">
    <header class="post-banner">
      <line-art seed={post.id} hue={hueFor(post)} track=".post-banner" />
      <div class="post-head">
        <p class="meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
          <span>{readingMinutes(post)} min read</span>
          {draft && <span class="draft">Draft</span>}
        </p>
        <h1>{title}</h1>
        <p class="desc">{description}</p>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      tags.length > 0 && (
        <ul class="tags post-tags">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
  <script>
    // A copy button on every code block.
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
          button.textContent = "Copied";
        } catch {
          button.textContent = "Press Ctrl+C";
        }
        setTimeout(() => (button.textContent = "Copy"), 1500);
      });
      const wrap = document.createElement("div");
      wrap.className = "code-wrap";
      pre.replaceWith(wrap);
      wrap.append(pre, button);
    }
  </script>
</Base>
